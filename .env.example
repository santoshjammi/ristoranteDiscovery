# =========================================================================
# TIRDE VPS Deployment Environment Variables Template (.env)
# Rename this file to '.env' and modify the values for your VPS environment.
# =========================================================================

# -------------------------------------------------------------------------
# Port Allocations (Choose non-conflicting ports for your VPS apps)
# -------------------------------------------------------------------------
PORT_FRONTEND=3040
PORT_BACKEND=5040

# -------------------------------------------------------------------------
# Public API URL (Critical for Client-side Next.js browser calls)
# -------------------------------------------------------------------------
# If testing locally or raw port routing:
# NEXT_PUBLIC_API_URL=http://localhost:5040/api
#
# If deploying on VPS using direct IP and port routing:
# NEXT_PUBLIC_API_URL=http://<YOUR_VPS_IP>:5040/api
#
# If deploying on VPS behind Nginx subdomains (recommended):
# NEXT_PUBLIC_API_URL=https://tirde.yourdomain.com/api
NEXT_PUBLIC_API_URL=http://localhost:5040/api

# -------------------------------------------------------------------------
# AI LLM Provider Configuration (Optional, falls back to Mock engine if blank)
# -------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
