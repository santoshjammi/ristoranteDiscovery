# =========================================================================
# RistoranteDiscovery / TIRDE — Environment Template (.env.example)
# =========================================================================
# Copy to `.env` and set real values for your environment.
# `.env` is gitignored — never commit real secrets.
#
# Consumed by docker-compose.yml for `${VAR}` interpolation AND by the
# backend process itself. Keep in sync with docker-compose.yml.
# =========================================================================

# -------------------------------------------------------------------------
# Port Allocations (host-published; bound to 127.0.0.1 — NGINX is the sole
# external ingress in production)
# -------------------------------------------------------------------------
PORT_FRONTEND=3040
PORT_BACKEND=5040

# -------------------------------------------------------------------------
# Public API URL — baked into the Next.js bundle at BUILD time.
# frontend/app/lib/api-config.ts normalizes this to an origin and appends
# `/api` exactly once, so either form works.
# -------------------------------------------------------------------------
# Local / OrbStack:
NEXT_PUBLIC_API_URL=http://127.0.0.1:5040/api
# VPS by IP:
# NEXT_PUBLIC_API_URL=http://<YOUR_VPS_IP>:5040/api
# VPS behind NGINX subdomain (recommended):
# NEXT_PUBLIC_API_URL=https://tirde.yourdomain.com/api

# -------------------------------------------------------------------------
# Admin bootstrap (REQUIRED in production)
# -------------------------------------------------------------------------
# backend/src/lib/seed.ts creates admin@ristorante.app ONLY when this is
# non-empty AND NODE_ENV=production. Without it the seed refuses to create
# an admin, so no user row exists and every signin returns 401.
# Idempotent: restarting will NOT overwrite an existing admin's hash.
ADMIN_PASSWORD=

# -------------------------------------------------------------------------
# JWT signing secret (set a real random value in production)
# -------------------------------------------------------------------------
JWT_SECRET=change-me-in-production

# -------------------------------------------------------------------------
# AI — local Ollama runs on the HOST; the container reaches it via the
# host.docker.internal host-gateway mapping declared in docker-compose.yml.
# Without that mapping, localhost:11434 resolves to the container itself.
# -------------------------------------------------------------------------
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_LIGHT_MODEL=
OLLAMA_COMPLEX_MODEL=

# -------------------------------------------------------------------------
# AI — optional cloud providers (blank = local-only / mock fallback)
# -------------------------------------------------------------------------
NVIDIA_API_KEY=
OLLAMA_API_KEY=

# -------------------------------------------------------------------------
# Payments (blank = subscription features fall back to mock mode)
# -------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
