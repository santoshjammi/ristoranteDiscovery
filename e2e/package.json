{
  "name": "ristoreDiscovery-e2e",
  "version": "1.0.0",
  "description": "End-to-end tests for Ristorante Discovery Intelligence platform",
  "type": "module",
  "scripts": {
    "e2e:install": "npx playwright install chromium",
    "e2e:dev-server": "cd ../backend && npx tsx src/index.ts",
    "e2e:test": "playwright test",
    "e2e:test:ui": "playwright test --ui",
    "e2e:test:headed": "playwright test --headed",
    "e2e:codegen": "npx playwright codegen http://localhost:3000"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "typescript": "^5.7.0"
  }
}
